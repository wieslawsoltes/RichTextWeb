+}
+.dark .statusbar select {
+  background: var(--chrome);
+  color: var(--ink);
+}
+@media (max-width: 1100px) {
+  #selection-status,
+  #show-navigation span {
+    display: none;
+  }
+  .statusbar {
+    gap: 7px;
+  }
+  .statusbar select {
+    max-width: 104px;
+  }
+  #editor-mode {
+    display: none;
+  }
+}
+@media (max-width: 700px) {
+  #word-count,
+  #page-arrangement,
+  #fit-page {
+    display: none;
+  }
+  .statusbar select {
