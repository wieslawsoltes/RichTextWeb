+  .statusbar {
+    gap: 5px;
+  }
+  #zoom {
+    width: 68px;
+  }
+  .titlebar {
+    gap: 8px;
+    padding: 0 10px;
+  }
+  .page-preview-dialog {
+    padding: 8px;
+  }
+}
